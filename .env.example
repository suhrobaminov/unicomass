# Public Supabase client configuration. These two values are safe to expose
# through VITE_ because they are publishable keys protected by Supabase RLS.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY"

# Server-only AI and search providers. Never add a VITE_ prefix to these.
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"
GROQ_API_KEY="OPTIONAL_FALLBACK_GROQ_API_KEY"
TAVILY_API_KEY="OPTIONAL_TAVILY_SEARCH_API_KEY"
BRAVE_SEARCH_API_KEY="OPTIONAL_BRAVE_SEARCH_API_KEY"

# Canonical production origin (Vercel redirects the apex domain to www).
SITE_URL="https://www.unicomass.online"
VITE_SITE_URL="https://www.unicomass.online"
